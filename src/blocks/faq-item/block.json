{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zehoro/faq-item",
	"title": "FAQ Item",
	"category": "zehoro-toolkit",
	"icon": "editor-help",
	"description": "A single question and answer in an FAQ.",
	"parent": [ "zehoro/faq" ],
	"textdomain": "zehoro-toolkit",
	"supports": {
		"html": false,
		"reusable": false
	},
	"attributes": {
		"question": {
			"type": "string",
			"default": ""
		},
		"startOpen": {
			"type": "boolean",
			"default": false
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
